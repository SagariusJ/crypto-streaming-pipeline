# Copia este archivo a .env y completa los valores.

# Kafka
KAFKA_TOPIC=crypto.trades
# Pares que el producer escucha en Coinbase (separados por coma)
PRODUCT_IDS=BTC-USD,ETH-USD,SOL-USD

# S3 local (RustFS) para desarrollo y CI. No son credenciales de AWS.
S3_LOCAL_ACCESS_KEY=<elige-un-usuario>
S3_LOCAL_SECRET_KEY=<elige-una-clave-de-al-menos-8-caracteres>
S3_LOCAL_BUCKET=crypto-lake
